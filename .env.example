# Copy to .env.local (never committed). In Vercel, set these per environment.
# Later phases fill in the rest; src/server/env.ts validates whatever is required.

# Caching (1.3): CDN cache time for public pages, in seconds. 300 = 5 min, 1800 = 30 min.
PUBLIC_CACHE_SECONDS=300

# Database (4.1)
DATABASE_URL=

# Auth (4.4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (4.4)
RESEND_API_KEY=

# Bot protection (4.4)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads (4.10)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cron and background jobs (4.10, 4.11)
CRON_SECRET=

# Kerbie (7.2)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
