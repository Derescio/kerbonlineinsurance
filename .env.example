# Copy to .env.local (never committed). In Vercel, set these per environment.
# Later phases fill in the rest; src/server/env.ts validates whatever is required.

# Caching (1.3): CDN cache time for public pages, in seconds. 300 = 5 min, 1800 = 30 min.
PUBLIC_CACHE_SECONDS=300

# PostHog product analytics (public browser configuration)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# Seed (4.9): `vp run db:seed` writes the synthetic cast and crowd to Neon `dev` only. Local only,
# never in Vercel. SEED_DATABASE_HOST is the dev direct host (it must match DATABASE_URL_UNPOOLED);
# SEED_INBOX is a plain address the cast's +addresses go to; SEED_PASSWORD (10+ chars) is every cast
# member's password; SEED_TOTP_SECRET (32 letters and digits) is the seeded staff's 2FA secret.
# SEED_BETTER_AUTH_SECRET is optional: Staging's BETTER_AUTH_SECRET, if yours differs.
SEED_DATABASE_HOST=
SEED_INBOX=
SEED_PASSWORD=
SEED_TOTP_SECRET=
# SEED_BETTER_AUTH_SECRET=

# Database (4.1): Neon `dev` locally, Staging and Preview; `prod` in Production.
# Use sslmode=verify-full in both. The app uses the pooled string (host contains -pooler).
DATABASE_URL=
# Migrations use the direct string (connection pooling off).
DATABASE_URL_UNPOOLED=
# Integration tests. Defaults to the Docker database from compose.yaml (vp run db:test:up).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/kerb_test

# Auth (4.4). One BETTER_AUTH_SECRET per database (`openssl rand -base64 32`): Development, Preview
# and Staging all use Neon `dev`, so they share one value; Production has its own. It encrypts TOTP
# secrets (4.6), so a mismatch breaks 2FA and rotating it disables every enrolled authenticator.
# BETTER_AUTH_URL is unset on Preview (built from VERCEL_URL).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Staging and Preview only, the same value in both: seals Google's round trip through staging
OAUTH_PROXY_SECRET=

# Audit (4.5b): HMAC keys for the audit chain. One set for Neon `dev` (Development, Preview,
# Staging) and one for `prod` (Production only). `openssl rand -base64 32` per key.
# Rotate by adding v2 and making it active; keep v1 listed so old rows still verify.
AUDIT_HMAC_KEYS=
AUDIT_HMAC_ACTIVE_VERSION=

# Email (4.4): Resend, sending from the verified kerb.opsedsolutions.com
RESEND_API_KEY=
EMAIL_FROM=

# Bot protection (4.4): Cloudflare Turnstile. Preview and Development use Cloudflare's test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA).
VITE_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads (4.10)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cron (4.7): Vercel Cron sends it as a Bearer header to /api/cron/*. A random 32-byte value,
# `openssl rand -base64 32`; set in Vercel (Preview, Production) and .env.local. Also 4.10, 4.11.
CRON_SECRET=

# Kerbie (7.2)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Deployment Protection bypass for automation on Staging/Preview (1.5, used by e2e in 3.4)
VERCEL_AUTOMATION_BYPASS_SECRET=

